{
  "name": "philanthropy-map-root",
  "private": true,
  "scripts": {
    "dev": "npm run dev:all",
    "build": "npm run build:client",
    "dev:client": "cd client && npm run dev",
    "dev:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\admin-laravel\\scripts\\serve-local.ps1",
    "dev:all": "concurrently -k \"npm run dev:client\" \"npm run dev:admin\"",
    "build:client": "cd client && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
